# NotePadLX: writes the list of ported menu commands (the "case IDM_..." labels of Notepad_plus::command
# in src/ui/NppCommands.cpp) as "case IDM_X:" lines, so the main menu enables exactly the ported commands.
# Usage: cmake -DINPUT=<NppCommands.cpp> -DOUTPUT=<PortedCommands.inc> -P GenPortedCommands.cmake

file(READ "${INPUT}" content)
string(REGEX MATCHALL "case[ \t]+ID[MC]_[A-Z0-9_]+" labels "${content}")
set(ids "")
foreach(label IN LISTS labels)
    string(REGEX REPLACE "case[ \t]+" "" id "${label}")
    list(APPEND ids "${id}")
endforeach()
list(REMOVE_DUPLICATES ids)
list(SORT ids)

set(out "// Generated by cmake/GenPortedCommands.cmake from src/ui/NppCommands.cpp - do not edit\n")
foreach(id IN LISTS ids)
    string(APPEND out "case ${id}:\n")
endforeach()

# Only touch the file when it changes, to avoid needless rebuilds
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT "${previous}" STREQUAL "${out}")
    file(WRITE "${OUTPUT}" "${out}")
endif()
